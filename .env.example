# Pramana Environment Configuration Template
# Copy this file to .env and configure your values:
# cp .env.example .env

# Server Port
PORT=3001

# SQLite Database Connection (defaults automatically to file:/tmp/dev.db on Vercel serverless)
DATABASE_URL="file:./dev.db"

# JWT Secret for Merchant Authentication
JWT_SECRET="pramana_merchants_secret_replace_in_production"

# Optional: Anthropic Claude Vision API Key (for Claude 3.5 Sonnet Vision extraction)
# If omitted, Pramana automatically uses the local Tesseract.js OCR engine (100% free & offline).
ANTHROPIC_API_KEY="sk-ant-api03-your-anthropic-api-key-here"

